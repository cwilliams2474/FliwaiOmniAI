APP_NAME=FLIWAI OmniAI API
ENVIRONMENT=development
POSTGRES_USER=omniai
POSTGRES_PASSWORD=replace_with_a_strong_database_password
POSTGRES_DB=omniai
DATABASE_URL=postgresql://omniai:replace_with_a_strong_database_password@db:5432/omniai
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRE_MINUTES=480
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_CODE_MODEL=gpt-5.3-codex
CORS_ORIGINS=http://localhost:3000
ADMIN_EMAILS=
UPLOAD_DIR=/app/uploads
RATE_LIMIT_PER_MINUTE=120
APP_BASE_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_STARTTLS=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/auth/sso/callback

# Dedicated bearer token for Prometheus scraping; use a long random value in production.
METRICS_TOKEN=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
