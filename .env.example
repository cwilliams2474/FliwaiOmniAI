# Copy to .env (scripts/install.sh does this and fills in the secrets for you).

# ---- Site ----
# A domain name gives you automatic HTTPS. Use :80 for plain HTTP on a LAN (then COOKIE_SECURE=false).
SITE_ADDRESS=omni.example.com
PUBLIC_URL=https://omni.example.com
COOKIE_SECURE=true
APP_NAME=OmniAI
ENVIRONMENT=production

# ---- Secrets (generate with: openssl rand -hex 32) ----
SECRET_KEY=
# Fernet key for encrypting MFA seeds and stored credentials:
# docker run --rm python:3.12-slim python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

# ---- Database ----
POSTGRES_USER=omniai
# Letters and digits only, so it is safe inside the connection URL.
POSTGRES_PASSWORD=
POSTGRES_DB=omniai

# ---- AI model provider ----
# none      : no model; chat shows the most relevant document passages
# openai    : any OpenAI-compatible API. Examples:
#               OpenAI      AI_BASE_URL=https://api.openai.com/v1           AI_MODEL=gpt-4o-mini
#               Ollama      AI_BASE_URL=http://host.docker.internal:11434/v1 AI_MODEL=llama3.1:8b  (AI_API_KEY can be blank)
#               vLLM/LiteLLM/LM Studio: their /v1 URL
# anthropic : Anthropic API. Set AI_MODEL to a current model ID from docs.claude.com and AI_API_KEY to your key.
AI_PROVIDER=none
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=1200
AI_TIMEOUT_SECONDS=90

# ---- Scheduled workflows ----
SCHEDULER_ENABLED=true
# Cron schedules are read in this time zone (Indiana follows America/New_York).
SCHEDULER_TIMEZONE=America/New_York

# ---- Email (optional, for password resets and invitations) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=omniai@example.com
SMTP_STARTTLS=true

# ---- Limits ----
SESSION_HOURS=12
MAX_UPLOAD_MB=25
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# ---- Backups (scripts/backup.sh) ----
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
