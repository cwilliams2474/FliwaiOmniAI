FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

FROM node:20-alpine AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
RUN addgroup -S omni && adduser -S omni -G omni
COPY --from=build --chown=omni:omni /app/.next/standalone ./
COPY --from=build --chown=omni:omni /app/.next/static ./.next/static
COPY --from=build --chown=omni:omni /app/public ./public
USER omni
EXPOSE 3000
CMD ["node", "server.js"]
